# === LOCAL DEV (sandbox) ===
# Uses local SQLite file — no setup needed
DATABASE_URL=file:./db/custom.db

# === PRODUCTION (Turso) ===
# Uncomment these and set to your Turso credentials for persistent storage
# Get these by running: bash setup-turso.sh
# DATABASE_URL=libsql://synnical-your-username.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# === OTHER ===
# Socket.IO URL (auto-set in start.sh, don't change)
# NEXT_PUBLIC_SOCKET_URL=/socket.io

